---
interface Props {
  id: number;
  name: string;
  year: number;
  image: string;
  type: string;
  description: string;
}

const { name, year, image, type, description, id } = Astro.props;

const sizeCardImage =
  type == "Horizontal"
    ? "col-span-2 row-span-2 w-50"
    : "col-span-1 row-span-2 w-50";
---

<!-- card videos and reels -->
<div
  class={`relative group overflow-hidden rounded-xl  ${
    type === "Horizontal" ? "col-span-2 row-span-2 " : "col-span-1 row-span-2"
  }`}
>
  <!-- Imagen -->
    <img
      src={image}
      alt={name}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
    />

    <!-- Overlay oscuro -->
    <div
      class="absolute inset-0 bg-black/20 group-hover:bg-black/60 transition duration-300"
    >
    </div>

    <!-- Contenido oculto -->
    <div class="absolute inset-0 flex flex-col justify-end p-4 text-white">
      <!-- Texto (animado) -->
      <div
        class="transform translate-y-10 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 "
      >
        <h3 class="text-lg font-bold">{name}</h3>
        <p class="text-sm text-gray-300">{year}</p>
        <p class="text-xs mt-2 line-clamp-2 mb-5">{description}</p>
        
        <a href={`/project/${id}`} class="font-black ring rounded-full p-2 h-10 text-[14px] glass-effect inline-flex w-full gap-2 items-center justify-center">Live View <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="icon icon-tabler icons-tabler-outline icon-tabler-circle-arrow-up-right"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
          d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path><path d="M15 9l-6 6"
        ></path><path d="M15 15v-6h-6"></path></svg
      > </a>
      </div>
    </div>
</div>
