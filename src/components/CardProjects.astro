---
interface Props {
  id: number;
  name: string;
  year: number;
  image: string;
  type: string;
  description: string;
}

const { name, year, image, type, description, id } = Astro.props;
---

<article
  class="w-full min-h-40 flex flex-col sm:flex-row flex-wrap rounded-[10px] justify-between gap-2 p-3  outline-1 outline-neutral-800 bg-linear-120 from-[#343a409a] to-neutral-900 to-80%"
>
  <div class="flex flex-2 rounded overflow-hidden">
    <img
      src={image}
      class="w-full h-60 object-cover"
      alt="Reel Instagram Portfolio"
    />
  </div>
  <div class="flex flex-3 flex-col gap-4">
    <h3
      class="text-lg font-black uppercase text-white border-b-[1.4px] border-neutral-700"
    >
      {name}
    </h3>
    <p class="text-white font-normal">
      {description}
    </p>
    <a href={`/project/${id}`}>
      <button
        class="uppercase font-bold w-auto rounded-[5px] h-10 group hover:ring-neutral-400 text-white ring ring-neutral-500 transition-shadow ease-in-out duration-300 cursor-pointer flex flex-row items-center justify-center gap-1 p-3"
      >
        <p class="text-[13px]">Live View</p>
        <svg
          class="group-hover:translate-x-1 rotate-2 ease-in duration-300"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-arrow-right-icon lucide-arrow-right"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
      </button>
    </a>
  </div>
</article>
