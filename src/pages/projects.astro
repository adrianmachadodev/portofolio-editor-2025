---
import Card from "../components/Card.astro";
import { PROJECTS } from "../const/projects";
import Layout from "../layouts/Layout.astro";



---

<Layout>
  <section
    class="w-full max-w-6xl mx-auto flex flex-col gap-5 items-center justify-center mt-20 "
  >
    <div class="w-full flex flex-col gap-4">
      <a
        href="/"
        class="p-2 rounded-full backdrop-blur-lg border border-white/10 bg-linear-to-tr from-black/60 to-black/40 shadow-lg hover:shadow-2xl hover:shadow-white/20 hover:scale-97 hover:rotate-0 active:scale-95 active:rotate-0 transition-all duration-300 ease-out cursor-pointer hover:border-white/30 hover:from-white/10 hover:to-black/40 group relative overflow-hidden w-40 h-10 items-center justify-center text-white text-center"
      >
        <div
          class="absolute inset-0 bg-linear-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out"
        >
        </div>
        Go back
      </a>
      <h2 class="text-white text-4xl font-black uppercase">Featured Works</h2>
    </div>

    <div class=" grid  grid-cols-2 md:grid-cols-3 gap-4 w-full wrap-normal">
      {
        PROJECTS.map((item) => (
          <Card
            description={item.description}
            id={item.id}
            image={item.image}
            name={item.name}
            type={item.type}
            year={item.year}
          />
        ))
      }
    </div>
  </section>
</Layout>
