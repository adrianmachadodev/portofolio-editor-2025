---
import { FAQ } from "../const/faq";
---

<section
  class="w-full sm:w-3xl overflow-hidden p-6 group flex flex-col items-center gap-4 bg-[#161615] bg-radial-[at_50%_10%] from-[#343a40] to-[#141111] to-65% text-center justify-center"
>
  <h2 class="text-white text-2xl font-bold uppercase">frequent questions</h2>

  {
    FAQ.map((item) => (
      <details
        name="faq"
        class="faq-item flex flex-col w-full text-whitegroup p-4 transition duration-500 cursor-pointer border-y border-neutral-600 group hover:bg-neutral-900 open:bg-neutral-800"
      >
        <summary class="flex flex-row marker:hidden justify-between text-white">
          <h3 class="text-xl transition duration-300 group-open:text-amber-300">
            {item.question}
          </h3>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="group-open:rotate-180 group-open:text-amber-300 transition-all ease-in duration-500 "
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-chevrons-down"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M7 7l5 5l5 -5" />
              <path d="M7 13l5 5l5 -5" />
            </>
          </svg>
        </summary>
        <div class="w-full grid grid-rows-[0fr] items-start mt-4 opacity-0 text-white transition-all duration-500 ease-in-out overflow-hidden group-open:grid-rows-[1fr] group-open:opacity-100">
          <div class="overflow-hidden">
            <p class="text-justify">{item.response}</p>
          </div>
        </div>
      </details>
    ))
  }
</section>

<style>
  .faq-item::before {
    content: "";
    inset-inline: 0;
    background-color: $$;
    transform-origin: 50%;
    height: 1px;
    transition: transform 0.22s var(--faq-ease-out);
    position: absolute;
    top: -1px;
    transform: scaleX(0);
  }
</style>
