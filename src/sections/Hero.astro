---

<section
  id="hero"
  class="min-h-[70vh] scroll-mt-10 mt-10 flex items-center justify-center w-full bg-[#161615] bg-radial-[at_50%_50%] from-[#292e33] to-[#141111] to-50%"
> 

  <div
    class="container w-full h-[40vh] flex flex-col gap-3 text-center justify-center"
  > 
    <h1 class="text-7xl font-bold text-white text-center">Hi, I'm Adrián</h1>
    <h2 class="text-5xl font-black text-white uppercase">
      Short-Form & Youtube Video Editor
    </h2>

    <div class="flex gap-5 flex-col items-center">
      <p class="text-[20px] text-[#B5B5C3] italic">
        I create videos that grow your brand through <strong>bold</strong>, <strong
          >dopamine-driven editing.</strong
        >
      </p>
      <a href="/projects">
        <button
          class="uppercase font-bold w-52 h-10 group rounded-3xl ring ring-neutral-400 text-white hover:shadow-md shadow-neutral-400 transition-all ease-out duration-500 cursor-pointer flex flex-row items-center justify-center gap-1"
          >View Projects
          <svg
            class="group-hover:translate-x-1 rotate-2 ease-in duration-300"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-arrow-right-icon lucide-arrow-right"
            ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
          >
        </button>
      </a>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="animate-bounce mt-10"
        width="30"
        height="30"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#6c757d"
        stroke-width="1.25"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-down"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
          d="M12 5l0 14"></path><path d="M18 13l-6 6"></path><path d="M6 13l6 6"
        ></path></svg
      >
    </div>
  </div>
</section>
