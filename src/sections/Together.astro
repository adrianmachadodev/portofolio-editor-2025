<section
  class="w-full sm:w-3xl min-h-auto p-6 group flex flex-col items-center gap-4 bg-[#161615] bg-radial-[at_100%_95%] from-[#343a40] to-[#141111] to-65% text-center justify-center outline outline-neutral-800 rounded"
>
  <div class="w-auto h-7 bg-green-400/15 ring ring-green-600 text-white rounded-2xl flex flex-row p-3 items-center gap-2">
    <div class="w-2 h-2 bg-green-400 ring ring-green-800 rounded-full flex items-center">
      <div class="w-2 h-2 absolute bg-green-400 rounded-full animate-ping"></div>
    </div>
    <span class="text-[13px]">Available for work</span>
  </div>
  <h3 class="text-4xl sm:text-5xl font-bold text-white">LET'S WORK TOGETHER</h3>
  <button
    id="email"
    class="uppercase font-bold w-28 rounded-[5px] h-10 group hover:shadow-md hover:shadow-neutral-400/20 text-white ring transition-shadow ease-in-out duration-300 cursor-pointer flex flex-row items-center justify-center gap-1 p-3"
  >
    <p class="text-[10px]" id="message-copy">Send Email</p>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      id="copy-icon"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-mail"
      ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
        d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"
      ></path><path d="M3 7l9 6l9 -6"></path></svg
    >
  </button>
</section>

<script>
  const btnEmail = document.querySelector("#email");
  const text = document.querySelector("#message-copy");
  const icon = document.querySelector("#copy-icon");

  const email = "machadoadriangabriel@gmail.com";

  btnEmail?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(email);

      if (text) text.textContent = "COPIED";

      if (btnEmail) {
        btnEmail.classList.remove("ring-neutral-400");
        btnEmail.classList.add("ring-green-400");
        btnEmail.classList.add("text-green-400");
        btnEmail.classList.add("text-green-400");
        btnEmail.classList.remove("text-white");
      }

      if (icon) {
        icon.innerHTML = `
        <path d="M5 12l5 5l10 -10" />
      `;
      }

      setTimeout(() => {
        if (text) text.textContent = "Send Email";

        if (btnEmail) {
          btnEmail.classList.remove("ring-green-400");
          btnEmail.classList.add("ring-neutral-400");
          btnEmail.classList.add("text-white");
          btnEmail.classList.remove("text-green-400");
        }

        if (icon) {
          icon.innerHTML = `
          <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10" />
          <path d="M3 7l9 6l9 -6" />
        `;
        }
      }, 2000);
    } catch (error) {
      console.log("error in clipboard");
    }
  });
</script>
